MONGODB_URI=mongodb://127.0.0.1:27017/diary
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Optional. The buttons stay hidden until both values for a provider are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Checkout returns an error until both are set.
# Point the Stripe webhook at /api/billing/webhook.
# Pro is $2 per month or $18 per year.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
